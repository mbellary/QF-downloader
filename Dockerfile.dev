FROM python:3.13-slim AS dev

WORKDIR /qf-downloader

# ----------------------------------------------------------------------------
# Install system deps once (cached layer)
# ----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
RUN pip install --no-cache-dir uv

# Copy pyproject.toml (and optional lock file)
COPY pyproject.toml uv.lock* README.md ./

# ----------------------------------------------------------------------------
# Install dependencies into SYSTEM PYTHON
# `uv export` → produces requirements.txt
# `uv pip install --system -r requirements.txt` → installs to system site-packages
# ----------------------------------------------------------------------------
RUN uv export --format requirements-txt > requirements.txt && \
    uv pip install --system -r requirements.txt


# Copy project (src + configs + pipelines) so script entrypoints can be installed.
COPY src ./src

# Install the project in editable mode so CLI scripts exist, and source changes
# via bind-mounts are reflected without rebuilding.
#RUN uv pip install --system --editable .

# Default to running commands through uv so README commands work unchanged.
ENTRYPOINT ["uv", "run", "--dev"]
