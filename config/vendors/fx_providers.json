        "NZDUSD"

      ],
      "source": "google_drive",
      "google_drive": {
        "root_folder_name": "FX-1-Minute-Data",
        "root_folder_id": "1IG_5SM3SLsxVeaDJlmL2qskex5EsTwjG",
        "granularity": "year",
        "subfolder_name_template": "{pair_lower}",
        "file_name_template": "DAT_ASCII_{pair}_M1_{year}.zip",
