
APP_ENV=localstack # SET in LOCAL WSL UBUNTU '~/.bashrc' as a GLOBAL VARIABLE

# LocalStack toggle
USE_LOCALSTACK=true

#endpoints
LOCALSTACK_URL=http://localhost:4566

# Development env
S3_BUCKET=fx-ml-data
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1

RAW_FILE_INDEX_TABLE=raw_file_index

DB_FILE= dev_downloads.db
PROVIDERS_FILE=fx_providers.json
POLL_INTERVAL_SECONDS=300

# optional API keys for providers
FX_API_KEY=
#ECON_API_KEY=your_dev_econ_key
TWELVEDATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=b087ce0d8a1c92999c87e282aa98d096

FETCH_MODE=backfill
# One time download for training
START_DATE=2015-01-01
END_DATE=2025-01-01

# rolling window for nightly training build
#START_DATE=$(date -d "7 days ago" +"%Y-%m-%d")
#END_DATE=$(date +"%Y-%m-%d")



