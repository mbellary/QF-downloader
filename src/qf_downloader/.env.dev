
APP_ENV=localstack

# LocalStack toggle
USE_LOCALSTACK=true

#endpoints
LOCALSTACK_URL=http://localhost:4566

# Development env
S3_BUCKET=fx-ml-data
AWS_ACCESS_KEY_ID=DEV_AWS_KEY
AWS_SECRET_ACCESS_KEY=DEV_AWS_SECRET
AWS_REGION=ap-south-1

RAW_FILE_INDEX_TABLE=raw_file_index

DB_PATH=./data/dev_downloads.db
PROVIDERS_FILE=./src/qf_downloader/providers.yaml
POLL_INTERVAL_SECONDS=300

# optional API keys for providers
FX_API_KEY=
#ECON_API_KEY=your_dev_econ_key
TWELVEDATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

FETCH_MODE=backfill
# One time download for training
START_DATE=2015-01-01
END_DATE=2025-01-01

# rolling window for nightly training build
#START_DATE=$(date -d "7 days ago" +"%Y-%m-%d")
#END_DATE=$(date +"%Y-%m-%d")



