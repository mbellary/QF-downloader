APP_ENV=production


# LocalStack toggle
USE_LOCALSTACK=false

#endpoints
LOCALSTACK_URL=http://localhost:4566

# Production env
S3_BUCKET=forex_eurusd
AWS_ACCESS_KEY_ID=PROD_AWS_KEY
AWS_SECRET_ACCESS_KEY=PROD_AWS_SECRET
AWS_REGION=ap-south-1

RAW_FILE_INDEX_TABLE=raw_file_index


DB_PATH=/data/prod_downloads.db
PROVIDERS_FILE=/app/qf_downloader/providers.yaml
POLL_INTERVAL_SECONDS=300

FX_API_KEY=
#ECON_API_KEY=your_dev_econ_key
TWELVEDATA_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

FETCH_MODE=incremental

# rolling window for nightly training build
START_DATE=$(date -d "7 days ago" +"%Y-%m-%d")
END_DATE=$(date +"%Y-%m-%d")